# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Get this from MongoDB Atlas: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/home_automation?retryWrites=true&w=majority

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Use a long random string — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=30d

# ─── HiveMQ Cloud MQTT ────────────────────────────────────────────────────────
# Sign up free at: https://console.hivemq.cloud
# After creating a cluster, go to "Manage Credentials" and create MQTT credentials
MQTT_HOST=your-cluster-id.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your_hivemq_username
MQTT_PASSWORD=your_hivemq_password
# Unique client ID for the backend server (must differ from ESP32 client IDs)
MQTT_CLIENT_ID=backend-server-001

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (for production)
# Leave as * for development
ALLOWED_ORIGINS=*
